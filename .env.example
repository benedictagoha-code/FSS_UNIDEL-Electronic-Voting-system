# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fss_voting
SESSION_SECRET=replace-with-at-least-32-random-bytes
OTP_PEPPER=replace-with-a-different-long-random-secret
SESSION_MAX_AGE_MS=28800000

# SMS integration is intentionally provider-neutral until a gateway is selected.
# Implement a provider adapter before enabling password-reset SMS in production.
SMS_PROVIDER=unconfigured
SMS_SENDER_ID=FSS-UNIDEL

# One-time first-admin setup only; set temporarily in the server environment.
ADMIN_BOOTSTRAP_CONFIRM=
