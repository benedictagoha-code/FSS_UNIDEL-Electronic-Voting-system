# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fss_voting
SESSION_SECRET=replace-with-at-least-32-random-bytes
OTP_PEPPER=replace-with-a-different-long-random-secret
SESSION_MAX_AGE_MS=28800000

# Termii SMS integration for password-reset OTPs.
# Set SMS_PROVIDER=termii only after adding a valid API key and approved sender ID.
# Termii transactional OTPs use the DND route; ask Termii to activate DND on the account.
SMS_PROVIDER=unconfigured
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=

# One-time first-admin setup only; set temporarily in the server environment.
ADMIN_BOOTSTRAP_CONFIRM=
